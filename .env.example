# Server-side only variables (safe pattern for public repos):
# Copy to .env.local and fill with real values.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anti-spam rate limit for /api/lead
LEAD_RATE_LIMIT_MAX_REQUESTS=8
LEAD_RATE_LIMIT_WINDOW_SECONDS=600

# Do not expose service role key in any NEXT_PUBLIC_* variable.
